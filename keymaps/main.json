{
  "lumine-text-editor:not([mini]):not([readonly])": {
    "cmdorctrl-k shift-b": "bib-finder:cite"
  },
  "lumine-text-editor:not([mini])": {
    "ctrl-f9": "bib-finder:open-source-1"
  },
  ".bib-finder lumine-text-editor[mini]": {
