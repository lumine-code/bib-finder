{
  // :not([mini]) because these insert a citation into the file.
  "atom-text-editor:not([mini])": {
    "f9": "bib-finder:cite",
    "ctrl-f9": "bib-finder:open-source-1"
  },
  ".bib-finder atom-text-editor[mini]": {
    "alt-enter": "bib-finder:insert-cite",
    "ctrl-enter": "bib-finder:insert-cite-square",
    "f5": "bib-finder:rebuild-cache"
  }
}
