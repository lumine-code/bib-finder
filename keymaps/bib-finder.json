{
  // The list's own verbs (enter / alt-enter / ctrl-enter / f5) are declared as
  // action keystrokes on the view, so the kernel registers them against
  // `atom-modal[data-modal-view="bib-finder.citations"]` and nothing belongs
  // here for them.
  "atom-text-editor": {
    "f9": "bib-finder:cite",
    "ctrl-f9": "bib-finder:open-source-1"
  }
}
